\@writefile{toc}{\contentsline {subsection}{\numberline {6.2}Training-only sign pin}{13}{subsection.6.2}\protected@file@percent }
\newlabel{sec:methodb}{{6.2}{13}{Training-only sign pin}{subsection.6.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Annualized Sharpe ratio per OOS test window of the baseline E2 deep SDF as trained (light) and under the ex-post orientation normalization (dark), with the market benchmark (dashed) for reference. Left: Iran (12 windows). Center: T\"urkiye (6). Right: Pakistan (6). The as-trained series are erratic; under the outcome-dependent orientation diagnostic the deep SDF's per-window Sharpe exceeds the market's in 16 of 24 windows. As Section~\ref {sec:orientationdefs} emphasizes, the dark bars are a diagnostic of latent portfolio content, not implementable performance.}}{14}{figure.1}\protected@file@percent }
\newlabel{fig:sign}{{1}{14}{Annualized Sharpe ratio per OOS test window of the baseline E2 deep SDF as trained (light) and under the ex-post orientation normalization (dark), with the market benchmark (dashed) for reference. Left: Iran (12 windows). Center: T\"urkiye (6). Right: Pakistan (6). The as-trained series are erratic; under the outcome-dependent orientation diagnostic the deep SDF's per-window Sharpe exceeds the market's in 16 of 24 windows. As Section~\ref {sec:orientationdefs} emphasizes, the dark bars are a diagnostic of latent portfolio content, not implementable performance}{figure.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Training-only sign-pinning experiment for E2. ``Raw'' is the original as-trained Sharpe; ``Pinned'' adds \eqref  {eq:pin} with $\lambda =1$. Bars denote means across seeds. $\bar  S_{10}$ is the mean at $\lambda =10$. ``Ex-post diagnostic'' is the seed-42 favorable-orientation calculation and uses test outcomes; it is shown only to make the information difference explicit.}}{14}{table.8}\protected@file@percent }
\newlabel{tab:pin}{{8}{14}{Training-only sign-pinning experiment for E2. ``Raw'' is the original as-trained Sharpe; ``Pinned'' adds \eqref {eq:pin} with $\lambda =1$. Bars denote means across seeds. $\bar S_{10}$ is the mean at $\lambda =10$. ``Ex-post diagnostic'' is the seed-42 favorable-orientation calculation and uses test outcomes; it is shown only to make the information difference explicit}{table.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Cross-market evidence hierarchy. Pricing ranks and Sharpe values are direct results; loss-gap and pinning calculations are diagnostics; the final column is a restrained interpretation rather than a causal estimate.}}{15}{table.9}\protected@file@percent }
\newlabel{tab:diagnosis}{{9}{15}{Cross-market evidence hierarchy. Pricing ranks and Sharpe values are direct results; loss-gap and pinning calculations are diagnostics; the final column is a restrained interpretation rather than a causal estimate}{table.9}{}}
